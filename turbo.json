{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN"
      ],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@todocarnes/brand#build": {
      "outputs": []
    },
    "@todocarnes/db#build": {
      "outputs": []
    },
    "@todocarnes/emails#build": {
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
