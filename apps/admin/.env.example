# Copiar a .env.local y completar. NUNCA commitear .env.local.
# Todos los valores de abajo son placeholders.

# ─── App ──────────────────────────────────────────────────────────────
# URL base de la app. Playwright la usa para navegar a /print desde el server.
APP_URL=http://localhost:3000

# ─── Export PDF ───────────────────────────────────────────────────────
# Token que protege /print/[catalogId]. Playwright corre en el server y no
# tiene la cookie de sesión del usuario, así que /print NO se protege con
# Supabase Auth. Generar con: openssl rand -hex 32
PRINT_TOKEN=

# ─── Supabase (desde M2) ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SOLO server. Bypassa RLS por diseño. Si esto aparece en un client
# component o con prefijo NEXT_PUBLIC_, la auditoría falla.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Imágenes ─────────────────────────────────────────────────────────
# mock | openai   — default mock. Ver docs/architecture.md §Imágenes.
IMAGE_PROVIDER=mock

# SOLO server. Cuenta de plataforma de Studio Nomade.
# Ojo: ChatGPT Plus/Pro NO habilitan la API. Se factura aparte en
# platform.openai.com, y gpt-image-1 exige verificación de organización.
OPENAI_API_KEY=

# ─── Seed (solo local) ────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrador
SEED_COMMERCIAL_EMAIL=
SEED_COMMERCIAL_PASSWORD=
SEED_COMMERCIAL_NAME=Comercial
