# URL pública de esta app.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Acceso al panel para colaboradores. En producción: https://admin.todocarnes.cl
NEXT_PUBLIC_ADMIN_URL=https://admin.todocarnes.cl

# Supabase. La URL y anon key son públicas; service role es SOLO server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Correos transaccionales. RESEND_API_KEY es SOLO server.
RESEND_API_KEY=
EMAIL_FROM="Todo Carnes <no-reply@todocarnes.cl>"
EMAIL_REPLY_TO=
# Notificaciones internas (lista separada por comas). El vendedor va en CC del correo al cliente.
EMAIL_INTERNAL_TO=frecabarren@tdcarnes.cl,rjz@tdcarnes.cl,webdesign@studionomade.cl

# Analítica sin cookies. Si está vacío, no se carga ningún script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Salt opcional para anonimizar la IP usada por el rate limit del formulario.
LANDING_RATE_LIMIT_SALT=
